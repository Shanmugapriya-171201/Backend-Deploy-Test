# Example values for local runs. Never commit real secrets.
# On Render, set these in the dashboard: Service > Environment.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
API_KEY=change-me-local-only
DUMMY_SECRET=pretend-this-is-a-databricks-token
INVESTIGATION_SECONDS=20
# KB_PATH is optional; defaults to the knowledge-base folder next to backend/
# KB_PATH=/full/path/to/knowledge-base
